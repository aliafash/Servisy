<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="#162a2d"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ce1126"
        android:gravity="center"
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="⚠️ تأكيد حذف البيانات الحساسة!"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="تحذير: هل أنت متأكد من المتابعة وحذف السجل/المزود المختار؟ سيؤدي هذا الإجراء لإزالة البيانات نهائياً وتطهيرها حياً من المنصة دون إمكانية التراجع."/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffff"
            android:id="@+id/btnCancelDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="إلغاء وفصل ❌"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#223639"/>
        <Button
            android:textColor="#162a2d"
            android:id="@+id/btnConfirmDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="نعم، موافق ومستمر ��"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#ffd700"/>
    </LinearLayout>
</LinearLayout>
