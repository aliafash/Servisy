<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffd700"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="�� تطهير قواعد البيانات"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="تحذير: سيتم حذف كافة البيانات، الحسابات، طلبات التسجيل، المحادثات، وبنرات الإعلانات بالكامل. لا يمكن التراجع عن هذا الإجراء!"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="أدخل كلمة مرور الأدمن للتأكيد:"/>
    <EditText
        android:textColor="#ffffff"
        android:textColorHint="#808080"
        android:id="@+id/passwordInput"
        android:background="@drawable/edit_text_border"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:hint="كلمة المرور"
        android:inputType="textPassword"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ff4444"
        android:gravity="center"
        android:id="@+id/errorText"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="❌ كلمة المرور غير صحيحة!"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffff"
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="تأكيد التطهير ��️"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#d32f2f"/>
        <Button
            android:textColor="#ffffff"
            android:id="@+id/cancelButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="إلغاء"
            android:layout_weight="1"
            android:backgroundTint="#444444"/>
    </LinearLayout>
</LinearLayout>
