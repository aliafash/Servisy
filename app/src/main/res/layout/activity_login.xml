<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F2225"
    android:textDirection="rtl"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 تسجيل دخول المهنيين"
            android:textColor="#FFCC00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_offline_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="للاستفسارات والاتصال الفوري (في حال عدم الاتصال بالشبكة): wam777644"
            android:textColor="#34C759"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Custom Username Container Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E3235"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/et_login_username"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="اسم المستخدم أو رقم الهاتف"
                android:textColor="#FFFFFF"
                android:textColorHint="#889999"
                android:background="@android:color/transparent"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:gravity="right" />
        </LinearLayout>

        <!-- Custom Password Container Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E3235"
            android:padding="4dp"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/et_login_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="رمز المرور السري"
                android:textColor="#FFFFFF"
                android:textColorHint="#889999"
                android:background="@android:color/transparent"
                android:padding="12dp"
                android:inputType="textPassword"
                android:gravity="right" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_submit_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="تسجيل دخول آمن 🔓"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#FFCC00" />

    </LinearLayout>
</ScrollView>
