<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#162A2D"
    android:padding="20dp"
    android:layout_gravity="center"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ تأكيد حذف البيانات والمزودين!"
        android:textColor="#CE1126"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:textDirection="rtl" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="انتبه: هل أنت متأكد من الحذف النهائي؟ سيتم مسح السجل أو مزود الخدمة تماماً من قاعدة البيانات صامتاً في الخلفية مع فرض حظر أمني شامل دون إمكانية فكه لاحقاً."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:textDirection="rtl" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:textDirection="rtl">

        <Button
            android:id="@+id/btnCancelDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="إلغاء وفصل العملية ❌"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#223639"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnConfirmDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="موافق، احذف نهائياً 🎯"
            android:textColor="#162A2D"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
