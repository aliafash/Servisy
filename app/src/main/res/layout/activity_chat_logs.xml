<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B1E"
    android:padding="16dp"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/chatTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💬 مراقبة غرف المحادثات الفعالة بالدليل"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="right"
        android:textDirection="rtl"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مشاهدة وتحليل المحادثات النشطة لإثبات الأمان ومنع الاحتيال والمخالفات بالتزامن المطور."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="right"
        android:textDirection="rtl"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:textDirection="rtl">

        <Button
            android:id="@+id/btnExportCSV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تصدير السجل (CSV) 📂"
            android:textColor="#162A2D"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مسح السجل 🧹"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#CE1126"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/chatsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#223639"
        android:dividerHeight="1dp" />

</LinearLayout>
