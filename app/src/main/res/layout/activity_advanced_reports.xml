<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F2225"
    android:padding="16dp"
    android:textDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📈 التقارير والرسوم البيانية المتقدمة للأداء"
        android:textColor="#FFCC00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="right"
        android:layout_marginBottom="16dp" />

    <!-- Filter Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="right"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_filter_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأسبوعي"
            android:backgroundTint="#1E3235"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_filter_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:text="الشهري 🗓️"
            android:backgroundTint="#FFCC00"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn_filter_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="السنوي"
            android:backgroundTint="#1E3235"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Custom Simulated Chart Card with Bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#1E3235"
        android:orientation="horizontal"
        android:gravity="bottom|center_horizontal"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <!-- Bar 1 Sanaa -->
        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom"
            android:layout_margin="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="٨5٪"
                android:textColor="#FFCC00"
                android:textSize="10sp" />
            <View
                android:layout_width="20dp"
                android:layout_height="140dp"
                android:background="#34C759" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صنعاء"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Bar 2 Aden -->
        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom"
            android:layout_margin="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="٦٠٪"
                android:textColor="#FFCC00"
                android:textSize="10sp" />
            <View
                android:layout_width="20dp"
                android:layout_height="100dp"
                android:background="#007AFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عدن"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Bar 3 Taiz -->
        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom"
            android:layout_margin="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="٤٥٪"
                android:textColor="#FFCC00"
                android:textSize="10sp" />
            <View
                android:layout_width="20dp"
                android:layout_height="75dp"
                android:background="#FFA500" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تعز"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Details Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3235"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 ملخص التحليلات العامة:"
            android:textColor="#FFCC00"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="right"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_report_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إجمالي الحجوزات النشطة: ٨7 عملية حجز\nنسبة الاستجابة الفورية للمهنيين: ٩٤٪\nأكثر المحافظات نشاطاً بالدليل: العاصمة صنعاء"
            android:textColor="#DDDDDD"
            android:textSize="12sp"
            android:gravity="right"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

</LinearLayout>
