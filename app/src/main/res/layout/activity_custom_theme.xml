<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B1E"
    android:textDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:textDirection="rtl">

        <TextView
            android:id="@+id/themeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎨 تخصيص ألوان وتنسيقات التطبيق"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="right"
            android:textDirection="rtl"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تعديل الألوان الرئيسية والفرعية، حجم الخط المعتمد، وخصائص واجهات العرض بكل مرونة وسهولة."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="right"
            android:textDirection="rtl"
            android:layout_marginBottom="16dp" />

        <!-- Cover Image Preview instead of text base64 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#162A2D"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:textDirection="rtl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🖼️ صورة غلاف التطبيق المعتمدة حالياً (بواسطة Glide):"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginBottom="6dp" />

            <ImageView
                android:id="@+id/ivCoverPreview"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:background="#0D1B1E"
                android:contentDescription="معاينة صورة غلاف الدليل" />

            <Button
                android:id="@+id/btnUploadCover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رفع غلاف جديد 📸"
                android:textSize="12sp"
                android:layout_gravity="right"
                android:layout_marginTop="8dp"
                android:backgroundTint="#223639"
                android:textColor="#FFD700" />
        </LinearLayout>

        <!-- Colors Card Mockup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#162A2D"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:textDirection="rtl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎨 تغيير ألوان وجهات العرض المباشرة"
                android:textColor="#FFD700"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etPrimaryColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="كود اللون الرئيسي (Primary Hex, e.g. #CE1126)"
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:gravity="right"
                android:textDirection="rtl"
                android:text="#CE1126" />

            <EditText
                android:id="@+id/etAccentColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="كود اللون الفرعي (Accent Hex, e.g. #FFD700)"
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:gravity="right"
                android:textDirection="rtl"
                android:text="#FFD700" />
        </LinearLayout>

        <!-- Sliders Card Mockup -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#162A2D"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:textDirection="rtl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 التحكم بأحجام أيقونات الدردشة والمساعد"
                android:textColor="#FFD700"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل مقاس أيقونة الدردشة الفورية"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="right"
                android:textDirection="rtl" />

            <SeekBar
                android:id="@+id/sbChatIconSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="60"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="تعديل مقاس أيقونة المساعد الصوتي والذكي"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="right"
                android:textDirection="rtl" />

            <SeekBar
                android:id="@+id/sbAssistantSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveThemeSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ وتثبيت المظهر الجديد 💾"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#CE1126" />

    </LinearLayout>
</ScrollView>
