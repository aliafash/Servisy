<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B1E"
    android:padding="16dp"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/categoriesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📁 إدارة هيكلية الأقسام والمدن اليمنية"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="right"
        android:textDirection="rtl"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تصفح وتعديل وحظر أو ترشيح أقسام المهن والخدمات على مستوى الجمهورية اليمنية."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="right"
        android:textDirection="rtl"
        android:layout_marginBottom="16dp" />

    <!-- Edit Category Form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#162A2D"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:textDirection="rtl">

        <EditText
            android:id="@+id/etCategoryNameAr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="اسم القسم أو الحرفة بالعربية"
            android:textColor="#FFFFFF"
            android:textColorHint="#33FFFFFF"
            android:gravity="right"
            android:textDirection="rtl"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖼️ معاينة أيقونة القسم الحقيقية عبر Glide:"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:gravity="right"
            android:textDirection="rtl"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/ivCategoryIconPreview"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="right"
            android:scaleType="centerCrop"
            android:background="#0D1B1E"
            android:contentDescription="معاينة أيقونة القسم" />

        <Button
            android:id="@+id/btnPickCategoryIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اختر ملف الأيقونة 🖼️"
            android:textSize="11sp"
            android:backgroundTint="#223639"
            android:textColor="#FFD700"
            android:layout_gravity="right"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/categoriesListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#223639"
        android:dividerHeight="1dp" />

</LinearLayout>
