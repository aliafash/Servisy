<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B1E"
    android:padding="16dp"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/bookingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 إدارة ومتابعة الحجوزات المجدولة بالجمهورية"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="right"
        android:textDirection="rtl"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تصفح كافة طلبات حجز المواعيد والخدمات المهنية بين العملاء ومزودي الخدمات في كافة أنحاء اليمن."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="right"
        android:textDirection="rtl"
        android:layout_marginBottom="16dp" />

    <!-- Image preview element replacing raw Base64 string/TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#162A2D"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:textDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖼️ معاينة مرفق الحجز وصورة العطل الحقيقية عبر Glide:"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:gravity="right"
            android:textDirection="rtl"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/ivBookingPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#0D1B1E"
            android:contentDescription="معاينة صورة عطل الحجز" />
    </LinearLayout>

    <ListView
        android:id="@+id/bookingsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#223639"
        android:dividerHeight="1dp" />

</LinearLayout>
