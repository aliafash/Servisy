<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E3235"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:textDirection="rtl"
    android:gravity="right">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="right">

        <TextView
            android:id="@+id/tv_chat_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="قناة الفني: أحمد صالح"
            android:textColor="#FFCC00"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ↔️ العميل"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_chat_last_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="آخر رسالة: يرجى إرسال التكلفة التقديرية"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="right"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tv_chat_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الوقت: منذ دقيقتين"
        android:textColor="#88AAAA"
        android:textSize="11sp"
        android:gravity="right"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="left"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_delete_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="حذف المحادثة 🗑️"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF4444"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_warn_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="تحذير الفني ⚠️"
            android:textColor="#000000"
            android:backgroundTint="#FFCC00"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
