<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Decoded Custom Image View Supporting Base64 & plain URLs -->
    <ImageView
        android:id="@+id/iv_decoded_category_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:background="#0F2225"
        android:contentDescription="Decoded Category Icon" />

    <TextView
        android:id="@+id/tv_decoded_category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
