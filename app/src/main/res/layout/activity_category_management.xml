<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F2225"
    android:padding="16dp"
    android:textDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛠️ إدارة الفئات والأقسام الحرفية"
        android:textColor="#FFCC00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="right"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_cat_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="اسم القسم الجديد (مثال: سباكة حديثة)"
        android:textColor="#FFFFFF"
        android:textColorHint="#99AAAA"
        android:background="#1E3235"
        android:padding="10dp"
        android:gravity="right"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="right"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_pick_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="رفع أيقونة الفئة 🖼️"
            android:backgroundTint="#FFCC00"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tv_icon_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لم يتم اختيار ملف"
            android:textColor="#CCCCCC"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_add_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إضافة وإطلاق القسم المهني 💾"
        android:textColor="#FFFFFF"
        android:backgroundTint="#34C759"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
