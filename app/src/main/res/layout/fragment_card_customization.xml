<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#122528"
    android:textDirection="rtl"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:textDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎴 تخصيص بطاقات الحرفيين ومزودي الخدمات"
            android:textColor="#FFCC00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="right"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ارتفاع الغلاف الدائري أو المربع للصورة وبُعدها:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="right"
            android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/card_height_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="300"
            android:progress="120"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تخصيص ألوان نصوص البطاقات الجانبية والأسماء:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="right"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="right"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/card_text_yellow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FFCC00"
                android:layout_margin="4dp" />
            <View
                android:id="@+id/card_text_white"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#FFFFFF"
                android:layout_margin="4dp" />
            <View
                android:id="@+id/card_text_gold"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#D4AF37"
                android:layout_margin="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعدادات شارات التميز (VIP &amp; موثق):"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="right"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/chk_vip_visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عرض شارة VIP المذهبة للأعضاء المميزين"
            android:textColor="#CCCCCC"
            android:gravity="right"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/chk_verified_visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عرض شارة موثق ونموذجي في اليمن"
            android:textColor="#CCCCCC"
            android:gravity="right"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/chk_recommended_visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفعيل موصى به للأرقام الحصرية التفاعلية"
            android:textColor="#CCCCCC"
            android:gravity="right"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_save_card_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFCC00"
            android:textColor="#000000"
            android:text="حفظ تعديلات البطاقات 💾"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
