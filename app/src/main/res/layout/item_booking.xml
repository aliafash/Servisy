<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E3235"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:textDirection="rtl"
    android:gravity="right">

    <TextView
        android:id="@+id/tv_booking_client"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="العميل: ماهر اليماني"
        android:textColor="#FFCC00"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="right" />

    <!-- 3 Custom Client Input Fields shown on bookingcard -->
    <TextView
        android:id="@+id/tv_booking_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الخدمة: صيانة مكثف لوحة رئيسية"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="right"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_booking_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="التوقيت واليوم: غداً العاشرة صباحاً"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="right"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tv_booking_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ملاحظات العميل: يرجى إحضار أسلاك تمديد كورية الصنع"
        android:textColor="#88AAAA"
        android:textSize="11sp"
        android:gravity="right"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tv_booking_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FFA500"
        android:textColor="#000000"
        android:text="قيد المراجعة 🕒"
        android:textSize="10sp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:gravity="right"
        android:layout_marginTop="8dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="left"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_cancel_booking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إلغاء ❌"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF4444"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_edit_booking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="تعديل ✏️"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007AFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_accept_booking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="قبول الحجز 👍"
            android:textColor="#000000"
            android:backgroundTint="#34C759"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
