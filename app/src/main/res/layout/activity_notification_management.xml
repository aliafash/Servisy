<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F2225"
    android:padding="20dp"
    android:textDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📢 مركز إدارة وبث الإشعارات الجماعية"
        android:textColor="#FFCC00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="right"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="عنوان التنبيه أو الإشعار العاجل:"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="right"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_notify_title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="مثال: تحديث أمني هام أو إطلاق قسم جديد"
        android:textColor="#FFFFFF"
        android:textColorHint="#99AAAA"
        android:background="#1E3235"
        android:padding="10dp"
        android:gravity="right"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تفاصيل ومحتوى رسالة البث الحية:"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="right"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_notify_body"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="يرجى كتابة تفاصيل الإشعار الذي سيتم إرساله لكافة مستخدمي ومهنيي المنصة باليمن..."
        android:textColor="#FFFFFF"
        android:textColorHint="#99AAAA"
        android:background="#1E3235"
        android:padding="10dp"
        android:gravity="top|right"
        android:layout_marginBottom="24dp"
        android:inputType="textMultiLine" />

    <Button
        android:id="@+id/btn_broadcast_push"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="إطلاق وإرسال التنبيه الجماعي السحابي 📡🚨"
        android:textColor="#000000"
        android:textStyle="bold"
        android:backgroundTint="#FFCC00" />

</LinearLayout>
